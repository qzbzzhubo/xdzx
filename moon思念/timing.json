[
  {
    "start": 0,
    "end": 6000000,
    "dur": 6.0,
    "title": true,
    "text": "月光下的思念"
  },
  {
    "start": 6000000,
    "end": 13536000,
    "dur": 7.536,
    "title": false,
    "text": "又是一年中秋，城市的霓虹灯很亮，却照不进心里那片柔软的地方"
  },
  {
    "start": 13536000,
    "end": 22680000,
    "dur": 9.144,
    "title": false,
    "text": "小时候，中秋是奶奶做的月饼，是院子里那棵老桂花树，是月光下一家人围坐的笑声"
  },
  {
    "start": 22680000,
    "end": 29016000,
    "dur": 6.336,
    "title": false,
    "text": "长大后，我们离开了家，走向了远方，却把思念留在了原地"
  },
  {
    "start": 29016000,
    "end": 34391999,
    "dur": 5.376,
    "title": false,
    "text": "那些年，总觉得来日方长，却忘了时间从不等人"
  },
  {
    "start": 34391999,
    "end": 40800000,
    "dur": 6.408,
    "title": false,
    "text": "如今，一条消息、一通电话，就能把思念送到千里之外"
  },
  {
    "start": 40800000,
    "end": 45791999,
    "dur": 4.992,
    "title": false,
    "text": "无论走多远，抬头看见的，永远是同一轮月"
  },
  {
    "start": 45791999,
    "end": 50303999,
    "dur": 4.512,
    "title": false,
    "text": "中秋快乐，愿你所念之人，也在念你"
  }
]